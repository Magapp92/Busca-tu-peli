# Copiar este archivo como .env y rellenar los valores

# Puerto donde arranca la API
PORT=3100

# Cadena de conexión a MongoDB (local o Atlas)
# Local:  mongodb://127.0.0.1:27017/buscatupeli  (127.0.0.1 y no localhost: con Node 18+ localhost puede resolver a IPv6)
# Atlas:  mongodb+srv://usuario:contraseña@cluster.xxxxx.mongodb.net/buscatupeli
MONGO_URI=mongodb://127.0.0.1:27017/buscatupeli

# Token de TMDB para importar películas (themoviedb.org → Ajustes → API → "Token de acceso de lectura")
TMDB_TOKEN=

# Clave del panel de administración (la que se escribe en el login del panel). En local puede quedar vacía
# (sin protección); en Netlify es obligatoria. Usa al menos 32 caracteres aleatorios
ADMIN_KEY=

# Clave con la que se firman los tokens de sesión del panel: cualquier cadena larga y aleatoria
# (obligatoria en Netlify y, en local, si se rellena ADMIN_KEY)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Solo para copiar los datos locales a Atlas (npm run copiar-a-atlas)
MONGO_URI_ATLAS=
